# ─────────────────────────────────────────────────────────────
#  ⚠️  보안 경고
#  - 이 파일을 복사해 ".env" 로 만들고 값을 채우세요.
#  - .env 파일은 절대 git에 커밋하거나 타인에게 공유하지 마세요.
#  - PRIVATE_KEY 에는 "테스트넷 전용" 지갑의 키만 넣으세요.
#    실제 자산이 든 지갑의 키는 절대 사용하지 마세요.
# ─────────────────────────────────────────────────────────────

# 배포에 사용할 테스트넷 지갑의 프라이빗키 (0x 포함)
PRIVATE_KEY=

# (선택) opBNB 테스트넷 RPC. 비워두면 공개 RPC 사용.
OPBNB_RPC=https://opbnb-testnet-rpc.bnbchain.org

# (선택) 컨트랙트 검증용 NodeReal API 키 (opbnbscan 검증 시)
NODEREAL_API_KEY=

# (선택) TGE 시각을 특정 unix timestamp로 고정하고 싶을 때. 비워두면 배포 시점.
TGE_TIMESTAMP=
