# ─────────────────────────────────────────────────────────────
#  ⚠️  보안 경고
#  - 이 파일을 복사해 ".env" 로 만들고 값을 채우세요.
#  - .env 파일은 절대 git에 커밋하거나 타인에게 공유하지 마세요.
#  - PRIVATE_KEY 에는 "테스트넷 전용" 지갑의 키만 넣으세요.
#    실제 자산이 든 지갑의 키는 절대 사용하지 마세요.
#  - 메인넷은 .env 에 키를 두지 않습니다 (하드웨어 지갑 + hardhat.mainnet.config.js).
# ─────────────────────────────────────────────────────────────

# 배포에 사용할 테스트넷 지갑의 프라이빗키 (0x 포함)
PRIVATE_KEY=

# (선택) RPC. 비워두면 공개 RPC 사용.
OPBNB_RPC=https://opbnb-testnet-rpc.bnbchain.org
BSC_TESTNET_RPC=https://data-seed-prebsc-1-s1.bnbchain.org:8545

# (선택) 포크 리허설: `npx hardhat run ...` 을 in-process 포크로 돌릴 때. (여러 스크립트에 걸친 상태 유지는 `hardhat node --fork`)
FORK_URL=
FORK_BLOCK=

# (선택) 컨트랙트 검증용 API 키
NODEREAL_API_KEY=
BSCSCAN_API_KEY=

# (선택) TGE 시각(unix 초). 비워두면 배포 시점+1h. 메인넷은 반드시 지정.
TGE_TIMESTAMP=

# (선택) 배포 마지막에 SLVesting 소유권을 이전할 타임락 주소 (deploy-timelock.js 출력)
VESTING_OWNER=

# (선택) 타임락 파라미터 (deploy-timelock.js)
TIMELOCK_DELAY=172800
TIMELOCK_PROPOSERS=
TIMELOCK_EXECUTORS=

# (선택) DEX 스크립트: 포크에서 실제 주소를 쓰려면 DEX=bsc, 사본이면 비움. USDT_ADDR 로 상대 토큰 지정 가능.
DEX=
USDT_ADDR=

# (선택) 모니터링 봇 텔레그램 알림
TG_BOT_TOKEN=
TG_CHAT_ID=
